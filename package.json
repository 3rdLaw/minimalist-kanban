{
  "name": "minimalist-kanban",
  "version": "0.9.0",
  "description": "Minimalist markdown-backed Kanban boards for Obsidian",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "build": "node esbuild.config.mjs production",
    "lint": "eslint src/ && npm run check",
    "check": "svelte-check --tsconfig ./tsconfig.check.json --threshold error",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npx tsx tests/e2e/sanity.e2e.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@eslint/json": "^0.14.0",
    "@sveltejs/vite-plugin-svelte": "^3.1.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/svelte": "^5.4.2",
    "@types/sortablejs": "^1.15.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitest/coverage-v8": "^1.6.1",
    "esbuild": "^0.28.1",
    "esbuild-svelte": "^0.9.5",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.1",
    "jsdom": "^30.0.1",
    "obsidian": "^1.13.1",
    "svelte": "^5.56.8",
    "svelte-check": "^4.7.4",
    "svelte-preprocess": "^6.0.5",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.65.0",
    "vitest": "^1.6.0"
  },
  "dependencies": {
    "monkey-around": "^3.0.0",
    "sortablejs": "^1.15.0"
  }
}
